# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# generated
/prisma/generated

# local database (SQLite)
/prisma/*.db
/prisma/*.db-journal
*.db
*.db-journal

# tools
/.bolt
/.vscode
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# agent tooling
/.agents
/.claude
/.codex
/.kilo
/skills-lock.json
# agent tooling that lives inside .github - ignored, not deleted
/.github/agents
/.github/hooks

# agent plan workspace
# Local planning and audit documents only. Nothing under /docs belongs in the
# repo - audits, implementation plans and the SDD workspace are working material
# for the session that produced them.
/docs/
# the SDD ledger and its review diffs. Its own nested .gitignore covers it with
# `*`, but that file ignores itself, so deleting it would expose all of it.
/.superpowers/
.neon
/.shots
/.impeccable
kilo.json
.mcp.json
