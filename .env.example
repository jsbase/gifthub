# Copy this file to BOTH .env and .env.local, then fill in the real values:
#   .env        - read by the Prisma CLI (migrate, db seed, db push, studio)
#   .env.local  - read by Next.js, and it takes precedence over .env
# A value that exists in only one of the two works in one tool and fails in
# the other, so keep both files in sync. Neither may ever be committed: a
# filled-in copy is a secret.

# Pooled PostgreSQL connection string for the hosted database. This is what the
# running app connects with. Locally this is the Neon `dev` branch - see the
# deploy notes in README.md for how the three Neon branches map onto the Vercel
# environments.
DATABASE_URL=

# Non-pooled connection string for the same database. Prisma Migrate needs this
# one: the pooled endpoint sits behind a connection pooler in transaction mode,
# which breaks the advisory locks `prisma migrate` relies on.
DIRECT_URL=

# Secret used to sign the session JWT. Any long random string.
JWT_SECRET=

# Base URL the app and the end-to-end tests talk to, e.g. http://localhost:3000
NEXT_PUBLIC_BASE_URL=

# Amazon PartnerNet (partnernet.amazon.de) tracking ID, e.g. `name-21`, written
# into the `tag` parameter of every amazon.de gift link. Optional: empty means
# links are left exactly as typed. Unlike the secrets above it is not a secret -
# it is visible in every affiliate link - but it is inlined into the client
# bundle at build time, so on Vercel it has to be set before the build and a
# change needs a redeploy. Only Next.js reads it, so it belongs in .env.local
# and not in .env.
NEXT_PUBLIC_AMAZON_TAG=
