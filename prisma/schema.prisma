// INFO: This is your Prisma schema file, learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * How far a list reaches.
 *
 * A single field rather than the absence of one. Two lists both with no access rows
 * look identical from outside, but they are not the same thing: a list the owner
 * has not decided about is private by default, and a list the owner has decided
 * to share and has not yet added anybody to is shared with nobody - a state the
 * owner can see the difference between and an outsider cannot. Deriving visibility
 * from an access-row count would make the second state indistinguishable from the
 * first, which is exactly the distinction the share dialog is built to express.
 */
enum ListVisibility {
  PRIVATE
  SHARED
}

/**
 * A person, rather than a name recorded inside a group.
 *
 * The product used to have no identity: a `Group` was a name plus one password
 * everyone in it shared, and a `User` row was a member name that could not sign in.
 * Both models are gone. An account is the thing the session JWT names and the thing
 * every list belongs to.
 */
model Account {
  id          String @id @default(cuid())

  /**
   * Stored trimmed and lowercased, never as typed.
   *
   * A bare `@unique` is case-sensitive in Postgres, so without this `Anna@x.de` and
   * `anna@x.de` become two accounts that each believe they are the only one, and
   * the person typing the second address sees "taken" for an address they do not
   * own. Normalisation happens on the way in and on the way to the comparison, not
   * only in the form, because a form can be bypassed.
   */
  email       String @unique
  password    String

  /**
   * The unique handle this person signs in with. Lowercased on the way in, and
   * unique in the database rather than in application code - a validator that
   * checks "is this taken" and a unique index that enforces it will disagree under
   * concurrency, and the constraint is the one that cannot be raced.
   *
   * Separate from `displayName` because the two answer different questions. This
   * one answers "who is signing in", which needs uniqueness, and display names
   * cannot provide it - two accounts are both called Anna. The display name answers
   * "what do I call this person in the header", which does not, and is theirs to
   * change without touching the handle they sign in with.
   */
  nickname    String @unique

  /**
   * Shown in the header in place of the wordmark, which `PRODUCT.md:72` makes a
   * brand commitment. Not unique, and not the login handle - see `nickname`.
   *
   * Defaults to the nickname on registration so that signing up asks for three
   * fields rather than four; this one can be set afterwards without touching the
   * handle. The registration route capitalises it on the way through, so a person
   * who typed `anna` is greeted as "Anna" without having been asked to type it
   * twice.
   */
  displayName String

  createdAt   DateTime     @default(now())
  lists       List[]
  access      ListAccess[]

  /**
   * The marks this account set. Never read by any read path - see `Gift.purchasedById`,
   * which is the other half of that contract. It exists only so that an owner can
   * tell their own mark from somebody else's.
   */
  purchases   Gift[]       @relation("GiftPurchase")

  /**
   * The groups this account owns, deliberately kept apart from `groupMemberships`:
   * owning a group and being in one are different things with different consequences,
   * and one relation would put the owner's own id into the audience of every group
   * they create. See `Group` on why an owner is never in their own group.
   */
  ownedGroups      Group[]

  /**
   * The groups other people have put this account in. Read only to answer "which
   * groups reach this list", and never shown to the member: whose group somebody is
   * in is the owner's business, and a member learns that they have access by opening
   * the list rather than by reading a membership page.
   */
  groupMemberships GroupMember[]
}

/**
 * One person's list, and the only thing in this product that is shared.
 */
model List {
  id         String         @id @default(cuid())
  name       String
  visibility ListVisibility @default(PRIVATE)
  ownerId    String
  owner      Account        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  gifts      Gift[]
  access     ListAccess[]

  /**
   * Group grants on this list. Read beside `access` by the shared-read predicate,
   * which is the only place a group's reach is ever decided: a row here says the list
   * is shared with that group, and says nothing at all about who may read it.
   */
  groupAccess ListGroupAccess[]

  @@index([ownerId])
}

/**
 * One person who may read one list, and mark its ideas bought.
 *
 * An owner has no row here: ownership is `List.ownerId`, not a grant, so there is
 * no second way to be in the set and no way for a revoked row to disagree with the
 * owner. `SHARED` without a row means "shared with nobody yet"; see `ListVisibility`
 * for why that is a state worth having.
 */
model ListAccess {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([listId, accountId])
  @@index([accountId])
}

/**
 * A named set of accounts, so that one share can reach several people at once.
 *
 * Not the `Group` this table borrows its name from. That one was a name plus a single
 * shared password and a list of member *names* that could not sign in - a secret to
 * hand around rather than a set of people - and it was removed in bae252d. A member
 * here is an `Account`, which brings its own password and can be revoked on its own,
 * so this table carries no credential of any kind and never will. That is what lets a
 * group's reach be a condition on a row rather than a thing somebody holds.
 *
 * `@@unique([ownerId, name])` rather than a bare `@unique` on `name`. The old
 * constraint was `Group_name_key`: one name for the entire database. That is not a
 * stricter version of what is wanted here, it is a different and wrong claim - "Family"
 * is a name inside one household, so a global constraint says two families cannot both
 * be called "Family", and the second of them has to invent "Family 2" for a word nobody
 * meant. The composite says what the owner actually promises, which is that *they*
 * cannot have two groups under one name.
 *
 * Ownership is not membership, and this model refuses to conflate them: an owner is
 * never implicitly in their own group, `cannot_share_with_owner` keeps holding, and an
 * owner reads a group-shared list by owning the list - the same shape as `ListAccess`
 * having no row for the owner of a list.
 */
model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     Account          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  members   GroupMember[]
  grants    ListGroupAccess[]

  @@unique([ownerId, name])
}

/**
 * One account in one group. The membership, and nothing derived from it.
 *
 * Whether that membership reaches any given list is worked out on every read by
 * walking `ListGroupAccess` to here; `ListGroupAccess` records why no audience is
 * written down anywhere.
 *
 * `@@unique([groupId, accountId])` so that a second attempt to add the same person is
 * a constraint violation rather than a duplicate row for whoever reads it next to
 * deduplicate. The argument is the one made for `nickname`: a handler that checks "is
 * this already a member" and an index that enforces it will disagree under
 * concurrency, and the index is the one that cannot be raced.
 *
 * `Cascade` from the account as well as from the group. A membership outliving the
 * account it names is a row that reaches nobody, and it shows up in a group's member
 * count as a person who is there and is not.
 */
model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())

  @@unique([groupId, accountId])
  @@index([accountId])
}

/**
 * One list shared with one group: the group counterpart of a `ListAccess` row, which
 * stays the only individual grant.
 *
 * What is stored is the grant. What is not stored is the audience that grant produces -
 * a member's reach is derived at read time by joining this row to `GroupMember`, so
 * there is deliberately no per-member row here, and the absence is the design.
 *
 * Snapshotting that audience instead - writing a `ListAccess` row per current member
 * when the list is shared - is the alternative this rejects. Removal then has to
 * *delete* rows, which means recording on every row which grant created it, and it
 * still cannot reach members added to the group afterwards without a backfill; the
 * stored audience drifts from the group either way. Derived, a removal changes the
 * answer on the next read because there is no stored row left to go stale, and
 * adding a member afterwards needs no backfill at all.
 *
 * It also answers the case that would be most annoying to get right by hand, for free:
 * an account holding both an individual grant and a group grant, who is then removed
 * from the group, keeps its access - the individual row is still there and the read
 * predicate is an `OR`. A snapshot design has to be told to preserve that, and an
 * instruction is a thing a later change can forget.
 */
model ListGroupAccess {
  id        String   @id @default(cuid())
  listId    String
  list      List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedAt DateTime      @default(now())

  @@unique([listId, groupId])
  @@index([groupId])
}

/**
 * One idea, on one list.
 *
 * The bought mark is shared: it belongs to everyone the list is shared with at the
 * moment it is set, and it is what makes double-buying structurally impossible
 * rather than a matter of good manners.
 */
model Gift {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String?

  isPurchased Boolean  @default(false)

  /**
   * Who set the mark, and never who it is for.
   *
   * Two contracts, both load-bearing and both tested:
   *
   *  1. Set when the mark is set, nulled when the mark is cleared. It is what lets
   *     an owner clear a mark they set while being refused one somebody else set -
   *     without it, either the owner can clear anyone's mark and double-buying
   *     becomes possible again, or the owner can never clear their own and "I got
   *     this myself" becomes permanent.
   *  2. Never selected into a response. No endpoint, no list shape and no
   *     serialization path includes it, so the buyer's identity is not a product
   *     output. The Prisma payload and the client's `Gift` are different types and
   *     the client's is a strict subset.
   *
   * `SetNull` on delete is deliberate and is the safe failure direction: a mark
   * that vanishes because the buyer deleted their account would leave an idea
   * looking unclaimed, which is a double-buy. A mark that survives with nobody
   * able to clear it is merely stuck.
   */
  purchasedById String?
  purchasedBy   Account? @relation("GiftPurchase", fields: [purchasedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}